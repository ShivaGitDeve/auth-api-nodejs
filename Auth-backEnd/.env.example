# Copy to .env and fill in real values. Never commit .env.

PORT=5000
# Public URL of this API (used in Swagger docs)
API_URL=http://localhost:5000

# PostgreSQL
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# JWT - use long random strings
JWT_SECRET=change_me
JWT_EXPIRE_IN=15m
REFRESH_JWT_SECRET=change_me_too
REFRESH_TOKEN_EXPIRES=7d

# Frontend URL - used in email links (reset password, welcome mail)
FRONTEND_URL=http://localhost:5173
# Allowed CORS origins, comma separated (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173

# Gmail + App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16charapppassword
